+#ifndef DRIVE_RESTART_GATE_H
+#define DRIVE_RESTART_GATE_H
+/* Pure C2B policy. Software decision only: NOT a functional-safety channel.
+ * `operator_pressed` MUST be a live physical-board input, never an HMI,
+ * retained memory or IPC command. Missing callback is always denied. */
+#include <stdbool.h>
+#include <stdint.h>
+#include "reset_diagnostics.h"
+#include "supervision_progress.h"
+
+typedef struct {
+    /* All fields must refer to the CURRENT boot/session and CURRENT cycle. */
+    bool valid;
+    bool operator_pressed;
+    bool board_ready;
+    bool reset_reviewed;
+    bool ipc_session_fresh;
+    bool old_commands_discarded;
+    bool feedback_revalidated;
+} DriveRestartBoardSample;
+
+typedef struct {
+    bool (*read)(void *context, DriveRestartBoardSample *out);
+    void *context;
+} DriveRestartBoardPort;
+
+typedef struct {
+    bool authorized;
+    bool inhibited;
+    bool observed_release;
+    bool previous_pressed;
+} DriveRestartGate;
+
+typedef struct {
+    bool communication_ready;
+    bool state_ready;
+    bool safety_valid;
+    bool estop_clear;
+    bool protective_stop_clear;
+    bool fault_clear;
+    bool ipc_valid;
+    bool preenable_status_checked;
+} DriveRestartSystemSample;
+
+static inline void drive_restart_gate_init(DriveRestartGate *gate)
+{
+    if (gate == NULL) return;
+    *gate = (DriveRestartGate){0};
+}
+
+static inline void drive_restart_gate_inhibit(DriveRestartGate *gate)
+{
+    if (gate == NULL) return;
+    gate->authorized = false;
+    gate->inhibited = true; /* Latch until NEW BOOT: RESET is not approval. */
+    gate->observed_release = false;
+    gate->previous_pressed = false;
+}
+
+static inline bool drive_restart_gate_tick(
+    DriveRestartGate *gate, const ResetDiagnostics *reset,
+    const DriveRestartBoardPort *port,
+    const DriveRestartSystemSample *system)
+{
+    if (gate == NULL || gate->inhibited) return false;
+    DriveRestartBoardSample board = {0};
+    if (reset == NULL || !reset->captured ||
+        port == NULL || port->read == NULL ||
+        system == NULL || !port->read(port->context, &board) ||
+        !board.valid || !board.board_ready ||
+        !system->communication_ready || !system->state_ready ||
+        !system->safety_valid || !system->estop_clear ||
+        !system->protective_stop_clear || !system->fault_clear ||
+        !system->ipc_valid || !system->preenable_status_checked)
+    {
+        if (gate->authorized) drive_restart_gate_inhibit(gate);
+        else { gate->observed_release = false; gate->previous_pressed = false; }
+        return false;
+    }
+    SupervisionResetReason reason = SUP_RESET_OTHER;
+    switch (reset->cause) {
+        case RESET_CAUSE_POWER_ON:
+            reason = SUP_RESET_EXPECTED_POWER_ON; break;
+        case RESET_CAUSE_BROWNOUT:
+            reason = SUP_RESET_BROWNOUT; break;
+        case RESET_CAUSE_WATCHDOG:
+            reason = SUP_RESET_WATCHDOG; break;
+        default: reason = SUP_RESET_OTHER; break;
+    }
+    /* C2A restart policy additionally blocks stale IPC and no-approval cases. */
+    const bool policy_without_operator = supervision_restart_authorized(
+        &(SupervisionRestartInputs){
+            .reason = reason,
+            .reset_cause_reviewed = board.reset_reviewed,
+            .fresh_ipc_session = board.ipc_session_fresh,
+            .stale_commands_discarded = board.old_commands_discarded,
+            .independent_safety_ready = board.board_ready,
+            .drive_feedback_revalidated = board.feedback_revalidated,
+            .operator_reauthorized = true
+        });
+    if (!policy_without_operator) {
+        if (gate->authorized) drive_restart_gate_inhibit(gate);
+        else { gate->observed_release = false; gate->previous_pressed = false; }
+        return false;
+    }
+    if (!gate->authorized) {
+        /* A held-high input at startup does NOT authorize. A low sample must
+         * occur AFTER all required startup conditions became valid. */
+        if (!board.operator_pressed) gate->observed_release = true;
+        if (gate->observed_release && !gate->previous_pressed &&
+            board.operator_pressed)
+            gate->authorized = true;
+    }
+    gate->previous_pressed = board.operator_pressed;
+    return gate->authorized;
+}
+#endif
diff --git a/Firmware/Tests/test_drive_restart_gate.c b/Firmware/Tests/test_drive_restart_gate.c
new file mode 100644
index 0000000..56886ec
--- /dev/null
+++ b/Firmware/Tests/test_drive_restart_gate.c
@@ -0,0 +1,122 @@
+#include "drive_restart_gate.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static DriveRestartBoardSample board;
+static unsigned reads;
+static bool read_board(void *ctx, DriveRestartBoardSample *out)
+{
+    (void)ctx;
+    ++reads;
+    *out = board;
+    return true;
+}
+static bool denied_board(void *ctx, DriveRestartBoardSample *out)
+{ (void)ctx; (void)out; return false; }
+static const DriveRestartBoardPort provider = {read_board, 0};
+static const DriveRestartBoardPort denied_provider = {denied_board, 0};
+static DriveRestartSystemSample good = {true,true,true,true,true,true,true,true};
+#define DENIED(g,r,p,s) assert(!drive_restart_gate_tick((g),(r),(p),(s)))
+#define ALLOWED(g,r,p,s) assert(drive_restart_gate_tick((g),(r),(p),(s)))
+
+static void base(void)
+{
+    board = (DriveRestartBoardSample){true,false,true,false,true,true,true};
+    reads = 0;
+}
+static void startup_case(uint32_t raw, bool reviewed)
+{
+    ResetDiagnostics reset = reset_diagnostics_from_raw(raw);
+    DriveRestartGate g;
+    drive_restart_gate_init(&g);
+    base(); board.reset_reviewed = reviewed;
+    DENIED(&g,&reset,&provider,&good);
+    board.operator_pressed = true;
+    ALLOWED(&g,&reset,&provider,&good);
+    assert(g.authorized && reads == 2);
+}
+int main(void)
+{
+    /* Power-on flags can include BOR/PIN/core/domain flags concurrently. */
+    startup_case(RESET_FLAG_POR | RESET_FLAG_BOR | RESET_FLAG_PIN |
+                 RESET_FLAG_C1 | RESET_FLAG_C2, false);
+    startup_case(RESET_FLAG_IWDG1 | RESET_FLAG_PIN, true);
+    startup_case(RESET_FLAG_WWDG2 | RESET_FLAG_C2, true);
+    startup_case(RESET_FLAG_BOR | RESET_FLAG_PIN, true);
+    startup_case(RESET_FLAG_SOFT1 | RESET_FLAG_PIN, true);
+    startup_case(RESET_FLAG_SOFT2 | RESET_FLAG_C2, true);
+    startup_case(RESET_FLAG_C1, true);
+    startup_case(RESET_FLAG_POR | RESET_FLAG_SOFT1, true);
+    assert(reset_diagnostics_classify(RESET_FLAG_POR) == RESET_CAUSE_POWER_ON);
+    assert(reset_diagnostics_classify(RESET_FLAG_BOR) == RESET_CAUSE_BROWNOUT);
+    assert(reset_diagnostics_classify(RESET_FLAG_IWDG1) == RESET_CAUSE_WATCHDOG);
+    assert(reset_diagnostics_classify(RESET_FLAG_SOFT1) == RESET_CAUSE_SOFTWARE);
+    assert(reset_diagnostics_classify(RESET_FLAG_C2) == RESET_CAUSE_CPU_OR_DOMAIN);
+    assert(reset_diagnostics_classify(0U) == RESET_CAUSE_UNKNOWN);
+    assert(reset_diagnostics_classify(RESET_FLAG_POR | RESET_FLAG_SOFT1) == RESET_CAUSE_MULTIPLE);
+
+    ResetDiagnostics r = reset_diagnostics_from_raw(RESET_FLAG_POR);
+    DriveRestartGate g;
+    drive_restart_gate_init(&g);
+    base();
+    DENIED(&g,&r,NULL,&good); /* absent production provider */
+    DENIED(&g,&r,&denied_provider,&good);
+    board.operator_pressed = true; /* stale/held input from prior boot */
+    DENIED(&g,&r,&provider,&good);
+    DENIED(&g,&r,&provider,&good);
+    board.operator_pressed = false;
+    DENIED(&g,&r,&provider,&good);
+    board.operator_pressed = true;
+    ALLOWED(&g,&r,&provider,&good);
+    /* Falling edge is not withdrawal; independent readiness is. */
+    board.operator_pressed = false;
+    ALLOWED(&g,&r,&provider,&good);
+    board.board_ready = false;
+    DENIED(&g,&r,&provider,&good);
+    board.board_ready = true;
+    board.operator_pressed = false;
+    DENIED(&g,&r,&provider,&good); /* latched inhibition */
+    board.operator_pressed = true;
+    DENIED(&g,&r,&provider,&good);
+    drive_restart_gate_init(&g);
+    base(); board.ipc_session_fresh = false;
+    DENIED(&g,&r,&provider,&good);
+    board.ipc_session_fresh = true;
+    board.old_commands_discarded = false;
+    DENIED(&g,&r,&provider,&good);
+    board.old_commands_discarded = true;
+    board.feedback_revalidated = false;
+    DENIED(&g,&r,&provider,&good);
+    board.feedback_revalidated = true;
+    DriveRestartSystemSample broken = good;
+    broken.estop_clear = false;
+    DENIED(&g,&r,&provider,&broken);
+    board.operator_pressed = true; /* never observed release while ready */
+    DENIED(&g,&r,&provider,&good);
+    board.operator_pressed = false;
+    DENIED(&g,&r,&provider,&good);
+    board.operator_pressed = true;
+    ALLOWED(&g,&r,&provider,&good);
+    broken = good;
+    broken.fault_clear = false;
+    DENIED(&g,&r,&provider,&broken);
+    DENIED(&g,&r,&provider,&good); /* reset cannot bypass */
+    drive_restart_gate_init(&g);
+    base();
+    ResetDiagnostics missing = {0};
+    DENIED(&g,&missing,&provider,&good);
+    r = reset_diagnostics_from_raw(RESET_FLAG_IWDG1);
+    board.reset_reviewed = false;
+    DENIED(&g,&r,&provider,&good);
+    board.operator_pressed = true;
+    DENIED(&g,&r,&provider,&good);
+    board.reset_reviewed = true;
+    DENIED(&g,&r,&provider,&good); /* held approval cannot become fresh */
+    board.operator_pressed = false;
+    DENIED(&g,&r,&provider,&good);
+    board.operator_pressed = true;
+    ALLOWED(&g,&r,&provider,&good);
+    puts("PASS: C2B reset classification and live-edge default-deny policy");
+    return 0;
+}
diff --git a/Firmware/Tests/run_drive_restart_gate_tests.py b/Firmware/Tests/run_drive_restart_gate_tests.py
new file mode 100644
index 0000000..5182608
--- /dev/null
+++ b/Firmware/Tests/run_drive_restart_gate_tests.py
@@ -0,0 +1,94 @@
+#!/usr/bin/env python3
+"""Execute genuine CM7-portable C2B policy and deliberate mutations.
+
+This does NOT claim a CM7/CM4 link, a full BOOT integration test, or real STO.
+Uses the production C2A header from the repository, unchanged.
+"""
+from pathlib import Path
+import subprocess
+import tempfile
+import shutil
+
+root = Path(__file__).resolve().parents[2]
+include_dir = root / "Firmware/STM32H745/Common/Inc"
+source = root / "Firmware/Tests/test_drive_restart_gate.c"
+policy = include_dir / "drive_restart_gate.h"
+reset = include_dir / "reset_diagnostics.h"
+supervision = include_dir / "supervision_progress.h"
+mutations = {
+    "require released input before rise": (
+        "gate->observed_release && !gate->previous_pressed &&",
+        "true &&"),
+    "revocation latch": (
+        "if (gate->authorized) drive_restart_gate_inhibit(gate);",
+        "if (false) drive_restart_gate_inhibit(gate);"),
+    "current reset/IPC policy": (
+        "if (!policy_without_operator) {",
+        "if (policy_without_operator && false) {"),
+    "live input provider": (
+        "port == NULL || port->read == NULL ||",
+        "false ||"),
+    "permanent restart inhibition": (
+        "if (gate == NULL || gate->inhibited) return false;",
+        "if (gate == NULL) return false;"),
+}
+
+def run_variant(header: str, label: str, should_pass: bool):
+    with tempfile.TemporaryDirectory(prefix="c2b_gate_") as d:
+        d = Path(d)
+        for h in (supervision, reset):
+            shutil.copyfile(h, d / h.name)
+        (d / "drive_restart_gate.h").write_text(header)
+        binary = d / "test"
+        compile_result = subprocess.run(
+            ["gcc", "-std=c11", "-O0", "-g", "-Wall", "-Wextra", "-Werror",
+             "-I", str(d), str(source), "-o", str(binary)],
+            capture_output=True, text=True)
+        if compile_result.returncode:
+            raise RuntimeError(label + ": C compilation failed:\n" + compile_result.stderr)
+        res = subprocess.run([str(binary)], capture_output=True, text=True)
+        if (res.returncode == 0) != should_pass:
+            raise AssertionError(f"{label}: unexpected exit {res.returncode}: {res.stdout} {res.stderr}")
+        print("PASS:", label, "baseline" if should_pass else "mutation rejected")
+
+original = policy.read_text()
+run_variant(original, "live policy", True)
+for label, (before, after) in mutations.items():
+    assert original.count(before) >= 1, f"mutation target absent: {label}"
+    run_variant(original.replace(before, after), label, False)
+print("PASS: all C2B host policy mutations killed")
+
+# Also exercise actual firmware BOOT decision code through a mock commissioning
+# port, not just a self-contained policy header. Do not weaken on failure.
+boot_src = root / "Firmware/STM32H745/CM7/Application/StateMachine/States/state_boot.c"
+cia_src = root / "ServoDrive/CiA402/cia402.c"
+boot_test = root / "Firmware/Tests/test_c2b_boot_path.c"
+with tempfile.TemporaryDirectory(prefix="c2b_boot_") as tmp:
+    cmd = ["gcc", "-std=c11", "-O0", "-g", "-Wall", "-Wextra", "-Werror",
+           "-I", str(root / "Firmware/STM32H745/CM7/Application/StateMachine/States"),
+           "-I", str(root / "StateMachine/States"),
+           "-I", str(root / "ServoDrive/CiA402"),
+           str(boot_src), str(cia_src), str(boot_test), "-o", str(Path(tmp)/"boot")]
+    compile_result = subprocess.run(cmd, capture_output=True, text=True)
+    if compile_result.returncode != 0:
+        raise RuntimeError("actual BOOT compile failed:\n" + compile_result.stderr)
+    result = subprocess.run([str(Path(tmp)/"boot")], capture_output=True, text=True)
+    if result.returncode != 0:
+        raise AssertionError("actual BOOT test failed: " + result.stderr)
+    print(result.stdout.strip())
+    # Deliberately remove the mandatory approval in the ENABLE path. The
+    # production test must then fail; no success-only mock is acceptable.
+    source = boot_src.read_text()
+    target = "if (!boot->drive_enable_authorized)"
+    assert source.count(target) >= 2, "must have wait and emission gate"
+    mutated = source.replace(target, "if (false)")
+    mutant_path = Path(tmp)/"state_boot.c"
+    mutant_path.write_text(mutated)
+    cmd[cmd.index(str(boot_src))] = str(mutant_path)
+    compile_result = subprocess.run(cmd, capture_output=True, text=True)
+    if compile_result.returncode != 0:
+        raise RuntimeError("BOOT mutant failed compilation:\n" + compile_result.stderr)
+    result = subprocess.run([str(Path(tmp)/"boot")], capture_output=True, text=True)
+    if result.returncode == 0:
+        raise AssertionError("BOOT emission gate mutation survived")
+    print("PASS: BOOT enable-gate removal mutation rejected")
diff --git a/Firmware/Tests/check_c2b_wiring.py b/Firmware/Tests/check_c2b_wiring.py
