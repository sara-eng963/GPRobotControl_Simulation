+    run_active_state(&ctx);
+    CHECK(ctx.machine.activeState == ROBOT_STATE_PATH_EXECUTION);
+    CHECK(ctx.path_execution.error != PATH_EXEC_ERR_CYCLIC_FEEDBACK);
